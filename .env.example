ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
APP_BASE_URL=

# Développement local UNIQUEMENT — ne jamais définir dans les secrets
# Streamlit Cloud ou tout environnement public : contourne complètement
# l'authentification (connexion admin automatique, accès total sans RLS).
LOCAL_DEV_AUTOLOGIN=
LOCAL_DEV_ADMIN_EMAIL=

# API publique /ask (Changethegame) — voir src/api/app.py
CTG_WEBHOOK_SECRET=
# true (défaut) : /ask a les données complètes SAUF le confidentiel ; false : données publiques seulement
CTG_ASK_FULL_ACCESS=
# Modèle de /ask (défaut claude-sonnet-5, comme l'agent du site)
ASK_MODEL=
API_ASK_MODEL=
# Propriétaire (auth.users) des lieux créés depuis ctg via PUT /ctg/objects ; sinon le propriétaire le plus fréquent des lieux existants
CTG_OWNER_USER_ID=
